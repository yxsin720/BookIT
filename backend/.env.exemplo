# =============================================================================
# BookIT · Exemplo de variáveis de ambiente
#
# COMO USAR
#   1. Copie este ficheiro para ".env":
#          Copy-Item .env.exemplo .env
#   2. Ajuste os valores abaixo.
#   3. O ".env" está no .gitignore e nunca vai para o repositório.
#      Este ".env.exemplo" é partilhado, por isso não ponha aqui segredos reais.
#
# REGRA DE OURO
#   Os valores da base de dados e do Redis têm de bater certo com o que está
#   em infraestrutura/docker/dockercompose.yml. Se um lado mudar e o outro não,
#   a aplicação não arranca ou não se liga.
# =============================================================================


# -----------------------------------------------------------------------------
# APP_ENV — nome do ambiente em que a aplicação corre
#   dev       -> desenvolvimento na sua máquina
#   test.dev  -> ambiente de teste dentro do Docker Compose
# -----------------------------------------------------------------------------
APP_ENV=dev


# -----------------------------------------------------------------------------
# DATABASE_URL — ligação ao PostgreSQL
#
# Formato:  postgresql://UTILIZADOR:PASSWORD@HOST:PORTA/BASE_DE_DADOS
#
# O HOST depende de ONDE a aplicação corre:
#   aplicação na sua máquina (fora do Docker)  ->  localhost
#   aplicação dentro do Docker Compose         ->  db   (nome do serviço)
#
# UTILIZADOR e BASE_DE_DADOS têm de ser iguais a "POSTGRES_USER" e
# "POSTGRES_DB" do dockercompose.yml. A PASSWORD é o POSTGRES_PASSWORD de lá.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:1234@localhost:5432/bookit


# -----------------------------------------------------------------------------
# REDIS_URL — ligação ao Redis
#
# Formato:  redis://HOST:PORTA/BASE
#
# O HOST segue a mesma regra do DATABASE_URL:
#   aplicação na sua máquina  ->  localhost
#   aplicação no Docker       ->  redis  (nome do serviço)
#
# A BASE é o número da base do Redis (0 a 15). Serve para separar dados
# entre ambientes, por exemplo dev na 0 e testes na 1.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# POSTGRES_PASSWORD — password do utilizador do PostgreSQL
#
# Tem de ser exatamente igual ao "POSTGRES_PASSWORD" definido em
# infraestrutura/docker/dockercompose.yml. É o valor que o contentor usa
# para criar o utilizador na primeira vez que arranca.
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=1234


# -----------------------------------------------------------------------------
# NGINX_ADDRESS — endereço onde o Nginx fica à escuta no host
#   0.0.0.0     -> aceita ligações de qualquer interface
#   127.0.0.1   -> só a sua máquina (mais seguro em desenvolvimento)
#
# Use um IP; é este valor que entra no mapeamento de portas do compose.
# -----------------------------------------------------------------------------
NGINX_ADDRESS=0.0.0.0


# -----------------------------------------------------------------------------
# HTTP_PORT — porta do host por onde se acede ao Nginx
#
# Endereço final:  http://localhost:HTTP_PORT
# A porta INTERNA do contentor é sempre a 80; esta é a de fora.
#
# Escolha uma porta livre. A 80 costuma estar ocupada (ex.: MAMP/Apache).
# -----------------------------------------------------------------------------
HTTP_PORT=8080
